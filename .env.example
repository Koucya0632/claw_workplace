# Web 端用來呼叫 FastAPI 的基礎網址。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API 服務對外監聽的主機與連接埠。
API_HOST=0.0.0.0
API_PORT=8000

# SQLite 資料庫位置，建議放在專案內的 data 目錄。
OPENCLAW_DATABASE_PATH=./data/openclaw.sqlite3

# 預設允許接入的本地資料夾根路徑。
OPENCLAW_LOCAL_SOURCE_BASE_PATH=./samples/local_source

# 掃描時允許處理的副檔名字串，使用逗號分隔。
OPENCLAW_ALLOWED_EXTENSIONS=pdf,docx,txt,md,csv,xlsx

# 單一文件允許摘要的最大字元數，避免過大文件直接打爆模型請求。
OPENCLAW_SUMMARY_MAX_CHARS=16000

# 預設 LLM provider 名稱，Phase 1 先固定用 minimax。
OPENCLAW_LLM_PROVIDER=minimax

# MiniMax 的 API Key，實際部署時請填入真值。
MINIMAX_API_KEY=

# MiniMax 的 API URL 由環境變數提供，避免把不確定的供應商端點寫死在程式碼中。
MINIMAX_API_URL=

# MiniMax 模型名稱，預設使用 OpenAI 相容文件中的可用模型。
MINIMAX_MODEL=MiniMax-M2.5

# 摘要請求逾時秒數。
MINIMAX_TIMEOUT_SECONDS=30

# OpenClaw CLI 可執行檔名稱，預設為 "openclaw"。
OPENCLAW_CLI_BIN=openclaw

# OpenClaw CLI 請求的逾時秒數。
OPENCLAW_CLI_TIMEOUT_SECONDS=20

# Agent Hook 透過 `openclaw agent` 跑完整 agent turn 的逾時秒數。
OPENCLAW_AGENT_DISPATCH_TIMEOUT_SECONDS=90

# 安全金鑰，請更改為一組長且隨機的字串（建議 32 位元以上）。
OPENCLAW_SECRET_KEY=change-this-to-a-long-random-secret-2026

# 原生 OpenClaw project-search plugin 要呼叫哪個 API base URL。
OPENCLAW_AGENT_TOOL_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Agent 搜索工具預設回傳的結果筆數。
OPENCLAW_AGENT_SEARCH_DEFAULT_LIMIT=5

# Agent 讀全文時預設最多回傳多少字元。
OPENCLAW_AGENT_DOCUMENT_MAX_CHARS=8000
